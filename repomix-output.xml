                                        modifier = Modifier.minimumInteractiveComponentSize()
                                    )
                                    HorizontalDivider()
                                    if (uiState.isPhotoIndexed) {
                                        DropdownMenuItem(
                                            text = { Text("Desindexar de IA") },
                                            leadingIcon = {
                                                Icon(
                                                    imageVector = Icons.Default.LayersClear,
                                                    contentDescription = null,
                                                    tint = MaterialTheme.colorScheme.error
