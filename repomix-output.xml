<file path="app/src/main/java/com/jhendefr/pixelupia/data/worker/MultimodalEnrichmentWorker.kt">
package com.jhendefr.pixelupia.data.worker

import android.content.Context
import android.net.Uri
import androidx.work.CoroutineWorker
import androidx.work.WorkerParameters
import com.jhendefr.pixelupia.data.local.room.SnapVaultDatabase
import com.jhendefr.pixelupia.data.ml.BarcodeDataSource
import com.jhendefr.pixelupia.data.ml.EntityExtractionDataSource
import com.jhendefr.pixelupia.data.ml.FaceDetectionDataSource
import com.jhendefr.pixelupia.data.ml.ImageLabelingDataSource
import com.jhendefr.pixelupia.data.ocr.TextRecognitionDataSource
import com.jhendefr.pixelupia.domain.usecase.EnrichScreenshotUseCase
import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.withContext

class MultimodalEnrichmentWorker(
    appContext: Context,
    workerParams: WorkerParameters
) : CoroutineWorker(appContext, workerParams) {

    override suspend fun doWork(): Result = withContext(Dispatchers.IO) {
        val database = SnapVaultDatabase.getInstance(applicationContext)
        val dao = database.smartGalleryDao()

        val unenrichedScreenshots = dao.getUnenrichedScreenshots()
        if (unenrichedScreenshots.isEmpty()) {
            return@withContext Result.success()
        }

        val barcodeDataSource = BarcodeDataSource(applicationContext)
        val faceDetectionDataSource = FaceDetectionDataSource(applicationContext)
        val imageLabelingDataSource = ImageLabelingDataSource(applicationContext)
        val entityExtractionDataSource = EntityExtractionDataSource()
        val textRecognitionDataSource = TextRecognitionDataSource(applicationContext)

        val enrichUseCase = EnrichScreenshotUseCase(
            barcodeDataSource = barcodeDataSource,
            faceDetectionDataSource = faceDetectionDataSource,
            imageLabelingDataSource = imageLabelingDataSource,
            entityExtractionDataSource = entityExtractionDataSource,
            smartGalleryDao = dao,
            textRecognitionDataSource = textRecognitionDataSource
        )

        for (photoEntity in unenrichedScreenshots) {
            if (isStopped) {
                return@withContext Result.retry()
            }
            try {
                enrichUseCase.enrichById(
                    photoId = photoEntity.photoId,
                    uri = Uri.parse(photoEntity.uri),
                    name = photoEntity.name,
                    folderName = photoEntity.folderName,
                    dateTaken = photoEntity.dateAdded
                )
            } catch (e: Exception) {
                // Continuar con la siguiente captura para no detener el worker
            }
        }

        Result.success()
    }
}
</file>

<file path="app/src/main/java/com/jhendefr/pixelupia/data/worker/WorkManagerScheduler.kt">
package com.jhendefr.pixelupia.data.worker

import android.content.Context
import androidx.work.*
import java.util.concurrent.TimeUnit

object WorkManagerScheduler {

    private const val PERIODIC_WORK_NAME = "MultimodalEnrichmentPeriodic"
    private const val ONE_TIME_WORK_NAME = "MultimodalEnrichmentOneTime"

    fun schedulePeriodicEnrichment(context: Context) {
        val constraints = Constraints.Builder()
            .setRequiresDeviceIdle(true)
            .setRequiresBatteryNotLow(true)
            .build()

        val periodicWorkRequest = PeriodicWorkRequestBuilder<MultimodalEnrichmentWorker>(
            12, TimeUnit.HOURS
        )
            .setConstraints(constraints)
            .build()

        WorkManager.getInstance(context).enqueueUniquePeriodicWork(
            PERIODIC_WORK_NAME,
            ExistingPeriodicWorkPolicy.KEEP,
            periodicWorkRequest
        )
    }

    fun triggerOneTimeEnrichment(context: Context) {
        val constraints = Constraints.Builder()
            .setRequiresBatteryNotLow(true)
            .build()

        val oneTimeWorkRequest = OneTimeWorkRequestBuilder<MultimodalEnrichmentWorker>()
            .setConstraints(constraints)
            .build()

        WorkManager.getInstance(context).enqueueUniqueWork(
            ONE_TIME_WORK_NAME,
            ExistingWorkPolicy.REPLACE,
            oneTimeWorkRequest
        )
    }
}
</file>

<file path="app/src/main/java/com/jhendefr/pixelupia/domain/classifier/ScreenshotSourceClassifier.kt">
package com.jhendefr.pixelupia.domain.classifier

import java.util.Locale

object ScreenshotSourceClassifier {

    // Patron estandar: Screenshot_YYYYMMDD_HHMMSS_AppName.ext o Screenshot_YYYYMMDD-HHMMSS_AppName.ext
    private val patternStandard = Regex(
        """^Screenshot[_-]\d{8}[_-]\d{6}[_-]([a-zA-Z0-9_\- ]+)\.[a-zA-Z0-9]+$""",
        RegexOption.IGNORE_CASE
    )

    // Patron con guiones largos: Screenshot_YYYY-MM-DD-HH-MM-SS_AppName.ext
    private val patternDashed = Regex(
        """^Screenshot[_-]\d{4}-\d{2}-\d{2}[_-]\d{2}-\d{2}-\d{2}[_-]([a-zA-Z0-9_\- ]+)\.[a-zA-Z0-9]+$""",
        RegexOption.IGNORE_CASE
    )

    // Patron generico de captura con sufijo de aplicacion
    private val patternGeneric = Regex(
        """^Screenshot.*?[-_]([A-Za-z][a-zA-Z0-9_ ]+)\.[a-zA-Z0-9]+$""",
        RegexOption.IGNORE_CASE
    )

    fun extractSourceApp(fileName: String?): String? {
        if (fileName.isNullOrBlank()) return null
        val cleanName = fileName.trim()

        patternStandard.find(cleanName)?.let { match ->
            val rawApp = match.groupValues[1]
            return formatAppName(rawApp)
        }

        patternDashed.find(cleanName)?.let { match ->
            val rawApp = match.groupValues[1]
            return formatAppName(rawApp)
        }

        // Si contiene la palabra Screenshot y un delimitador antes de la extension
        if (cleanName.startsWith("Screenshot", ignoreCase = true)) {
            val nameWithoutExt = cleanName.substringBeforeLast(".")
            val parts = nameWithoutExt.split("_", "-")
            if (parts.size >= 4) {
                val candidate = parts.last().trim()
                // Descartar si el candidato es solo numerico (ej. hora o timestamp)
                if (candidate.isNotEmpty() && !candidate.all { it.isDigit() }) {
                    return formatAppName(candidate)
                }
            }
        }

        return null
    }

    private fun formatAppName(rawName: String): String {
        val cleaned = rawName.replace("_", " ").trim()
        if (cleaned.isBlank()) return "Desconocido"
        return cleaned.split(" ")
            .filter { it.isNotBlank() }
            .joinToString(" ") { word ->
                word.replaceFirstChar { if (it.isLowerCase()) it.titlecase(Locale.ROOT) else it.toString() }
            }
    }
}
