) {
    val candidatePhotos = remember(allPhotos, existingPhotoIds, chosenIndexFolders) {
        allPhotos.filter { photo ->
            !existingPhotoIds.contains(photo.id) &&
            (chosenIndexFolders.isEmpty() || chosenIndexFolders.any { folder ->
