                                        modifier = Modifier.minimumInteractiveComponentSize()
                                    )
                                    DropdownMenuItem(
                                        text = { Text("Copiar a carpeta") },
                                        leadingIcon = { Icon(Icons.Default.FileCopy, contentDescription = null) },
                                        onClick = {
                                            showMoreMenu = false
                                            viewModel.onEvent(ViewerEvent.RequestCopy(currentPhoto))
