import androidx.lifecycle.compose.collectAsStateWithLifecycle
import coil.compose.AsyncImage
import com.jhendefr.pixelupia.domain.model.Album
import com.jhendefr.pixelupia.domain.model.Photo
import com.jhendefr.pixelupia.domain.model.SortOrder
import com.jhendefr.pixelupia.ui.common.ConfirmDeleteDialog
import com.jhendefr.pixelupia.ui.common.FolderPickerDialog
import com.jhendefr.pixelupia.ui.theme.PixelUpIAMotion
import java.util.ArrayList

@OptIn(ExperimentalMaterial3Api::class)
@Composable
fun GalleryScreen(
    viewModel: GalleryViewModel,
    onPhotoClick: (Photo, Boolean, String?) -> Unit = { _, _, _ -> },
    onAlbumClick: (Album) -> Unit = {}
) {
    val uiState by viewModel.uiState.collectAsStateWithLifecycle()
    val context = LocalContext.current
    val snackbarHostState = remember { SnackbarHostState() }
    var showSortMenu by remember { mutableStateOf(false) }

    // Manejo de retroceso nativo de Android
    BackHandler(enabled = uiState.isSelectionMode) {
        viewModel.onEvent(GalleryEvent.ClearSelection)
    }

    BackHandler(enabled = !uiState.isSelectionMode && uiState.selectedFaceCluster != null) {
        viewModel.onEvent(GalleryEvent.SelectFaceCluster(null))
    }

    BackHandler(enabled = !uiState.isSelectionMode && uiState.selectedFaceCluster == null && uiState.selectedIndexedFolderName != null) {
        viewModel.onEvent(GalleryEvent.SelectIndexedFolder(null))
    }

    BackHandler(enabled = !uiState.isSelectionMode && uiState.selectedFaceCluster == null && uiState.selectedIndexedFolderName == null && uiState.selectedSmartCollection != null) {
        viewModel.onEvent(GalleryEvent.SelectSmartCollection(null))
    }

    BackHandler(enabled = !uiState.isSelectionMode && uiState.selectedFaceCluster == null && uiState.selectedIndexedFolderName == null && uiState.selectedSmartCollection == null && uiState.selectedTab != GalleryTab.PHOTOS) {
        viewModel.onEvent(GalleryEvent.SelectTab(GalleryTab.PHOTOS))
    }

    val permission = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
        Manifest.permission.READ_MEDIA_IMAGES
    } else {
        Manifest.permission.READ_EXTERNAL_STORAGE
    }

    var hasPermission by remember { mutableStateOf(false) }

    val permissionLauncher = rememberLauncherForActivityResult(
        contract = ActivityResultContracts.RequestPermission()
    ) { isGranted ->
        hasPermission = isGranted
        if (isGranted) {
            viewModel.onEvent(GalleryEvent.Refresh)
        }
    }

    val intentSenderLauncher = rememberLauncherForActivityResult(
        contract = ActivityResultContracts.StartIntentSenderForResult()
    ) { result ->
        if (result.resultCode == Activity.RESULT_OK) {
            viewModel.onEvent(GalleryEvent.OnIntentSenderCompleted)
        } else {
            viewModel.onEvent(GalleryEvent.OnIntentSenderDismissed)
        }
    }

    LaunchedEffect(Unit) {
        permissionLauncher.launch(permission)
    }

    LaunchedEffect(uiState.pendingIntentSender) {
        uiState.pendingIntentSender?.let { sender ->
            intentSenderLauncher.launch(
                IntentSenderRequest.Builder(sender).build()
            )
        }
    }

    LaunchedEffect(uiState.userMessage) {
        uiState.userMessage?.let { message ->
            snackbarHostState.showSnackbar(message)
            viewModel.onEvent(GalleryEvent.ClearUserMessage)
        }
    }

    // Dialogos de Gestion
    if (uiState.showDeleteConfirm) {
        ConfirmDeleteDialog(
            count = uiState.selectedPhotoIds.size,
            onConfirm = { viewModel.onEvent(GalleryEvent.ConfirmDeleteSelected) },
            onDismiss = { viewModel.onEvent(GalleryEvent.DismissDeleteDialog) }
        )
    }

    if (uiState.showFolderPickerForMove) {
        FolderPickerDialog(
            title = "Mover ${uiState.selectedPhotoIds.size} fotos",
            existingFolders = uiState.existingFolderNames,
            onFolderSelected = { folder -> viewModel.onEvent(GalleryEvent.ConfirmMoveSelected(folder)) },
            onDismiss = { viewModel.onEvent(GalleryEvent.DismissMoveDialog) }
        )
    }

    if (uiState.showFolderPickerForCopy) {
        FolderPickerDialog(
            title = "Copiar ${uiState.selectedPhotoIds.size} fotos",
            existingFolders = uiState.existingFolderNames,
            onFolderSelected = { folder -> viewModel.onEvent(GalleryEvent.ConfirmCopySelected(folder)) },
            onDismiss = { viewModel.onEvent(GalleryEvent.DismissCopyDialog) }
        )
    }

    // Visor de Historias / Recuerdos Inteligentes a Pantalla Completa
    val currentActiveStory = uiState.activeStory
    if (currentActiveStory != null && uiState.activeStoryPhotos.isNotEmpty()) {
        com.jhendefr.pixelupia.ui.gallery.components.StoryViewerDialog(
            story = currentActiveStory,
            photos = uiState.activeStoryPhotos,
            onDismiss = { viewModel.onEvent(GalleryEvent.CloseStory) },
            onEditName = { viewModel.onEvent(GalleryEvent.OpenEditStoryName(it)) },
            onAddPhotos = { viewModel.onEvent(GalleryEvent.OpenAddPhotosToStory(it)) },
            onRemoveCurrentPhoto = { story, photoId -> viewModel.onEvent(GalleryEvent.RemovePhotoFromStory(story.storyId, photoId)) },
            onTogglePin = { viewModel.onEvent(GalleryEvent.ToggleStoryPinned(it.storyId, !it.isPinned)) },
            onDeleteStory = { viewModel.onEvent(GalleryEvent.DeleteStory(it.storyId)) }
        )
    }

    // Dialogos de Gestion de Recuerdos
    val storyToEdit = uiState.storyToEditName
    if (storyToEdit != null) {
        com.jhendefr.pixelupia.ui.gallery.components.EditStoryNameDialog(
            story = storyToEdit,
            onConfirm = { newTitle -> viewModel.onEvent(GalleryEvent.RenameStory(storyToEdit.storyId, newTitle)) },
            onDismiss = { viewModel.onEvent(GalleryEvent.OpenEditStoryName(null)) }
        )
    }

    val storyToAdd = uiState.storyToAddPhotos
    if (storyToAdd != null) {
        com.jhendefr.pixelupia.ui.gallery.components.AddPhotosToStoryDialog(
            story = storyToAdd,
            allPhotos = uiState.photos,
            onAddPhotos = { ids -> viewModel.onEvent(GalleryEvent.AddPhotosToStory(storyToAdd.storyId, ids)) },
            onDismiss = { viewModel.onEvent(GalleryEvent.OpenAddPhotosToStory(null)) }
        )
    }

    val storyToManage = uiState.storyToManagePhotos
    if (storyToManage != null) {
        com.jhendefr.pixelupia.ui.gallery.components.ManageStoryPhotosDialog(
            story = storyToManage,
            allPhotos = uiState.photos,
            onRemovePhoto = { photoId -> viewModel.onEvent(GalleryEvent.RemovePhotoFromStory(storyToManage.storyId, photoId)) },
            onDismiss = { viewModel.onEvent(GalleryEvent.OpenManageStoryPhotos(null)) }
        )
    }

    if (uiState.showCreateManualStoryDialog) {
        com.jhendefr.pixelupia.ui.gallery.components.CreateManualStoryDialog(
            allPhotos = uiState.photos,
            suggestedMemories = uiState.suggestedMemories,
            onCreateSuggestion = { suggestion -> viewModel.onEvent(GalleryEvent.CreateStoryFromSuggestion(suggestion)) },
            onCreate = { title, ids -> viewModel.onEvent(GalleryEvent.CreateManualStory(title, ids)) },
            onDismiss = { viewModel.onEvent(GalleryEvent.ToggleCreateManualStoryDialog(false)) }
        )
    }

    if (uiState.showCustomizeFilterChipsDialog) {
        val allDetectedCategories = uiState.visualCollections.map { it.title }.distinct()
        com.jhendefr.pixelupia.ui.gallery.components.CustomizeFilterChipsDialog(
            activeChips = uiState.activeFilterChips,
            availableSuggestions = allDetectedCategories,
            onSave = { chips -> viewModel.onEvent(GalleryEvent.SaveActiveFilterChips(chips)) },
            onResetToDefault = { viewModel.onEvent(GalleryEvent.ResetFilterChipsToDefault) },
            onDismiss = { viewModel.onEvent(GalleryEvent.ToggleCustomizeFilterChipsDialog(false)) }
        )
    }

    if (uiState.showSemanticPhotosDialog) {
        com.jhendefr.pixelupia.ui.gallery.components.SemanticVectorPhotosDialog(
            photos = uiState.semanticPhotos,
            onPhotoClick = { smartPhoto ->
                val matchingPhoto = uiState.photos.firstOrNull { it.id == smartPhoto.photoId }
                if (matchingPhoto != null) {
                    onPhotoClick(matchingPhoto, true, null)
                }
            },
            onDismiss = { viewModel.onEvent(GalleryEvent.ToggleSemanticPhotosDialog(false)) }
        )
    }

    Scaffold(
        containerColor = MaterialTheme.colorScheme.surfaceContainerLowest,
        snackbarHost = { SnackbarHost(snackbarHostState) },
        topBar = {
            AnimatedContent(
                targetState = uiState.isSelectionMode,
                transitionSpec = {
                    (fadeIn(animationSpec = PixelUpIAMotion.effectsFloatSpring) +
                            slideInVertically(animationSpec = PixelUpIAMotion.spatialIntOffsetSpring) { -it / 2 })
                        .togetherWith(
                            fadeOut(animationSpec = PixelUpIAMotion.effectsFloatSpring) +
                                    slideOutVertically(animationSpec = PixelUpIAMotion.spatialIntOffsetSpring) { -it / 2 }
                        )
                },
                label = "TopBarAnimation"
            ) { isSelection ->
                if (isSelection) {
                    TopAppBar(
                        title = {
                            Text(
                                text = "${uiState.selectedPhotoIds.size} seleccionadas",
                                style = MaterialTheme.typography.titleLarge,
                                fontWeight = FontWeight.SemiBold
                            )
                        },
                        navigationIcon = {
                            IconButton(
                                onClick = { viewModel.onEvent(GalleryEvent.ClearSelection) },
                                modifier = Modifier.minimumInteractiveComponentSize()
                            ) {
                                Icon(Icons.Default.Close, contentDescription = "Cancelar seleccion")
                            }
                        },
                        actions = {
                            IconButton(
                                onClick = { viewModel.onEvent(GalleryEvent.SelectAll) },
                                modifier = Modifier.minimumInteractiveComponentSize()
                            ) {
                                Icon(Icons.Default.SelectAll, contentDescription = "Seleccionar todo")
                            }
                        },
                        colors = TopAppBarDefaults.topAppBarColors(
                            containerColor = MaterialTheme.colorScheme.secondaryContainer,
                            titleContentColor = MaterialTheme.colorScheme.onSecondaryContainer,
                            navigationIconContentColor = MaterialTheme.colorScheme.onSecondaryContainer,
                            actionIconContentColor = MaterialTheme.colorScheme.onSecondaryContainer
                        )
                    )
                } else {
                    TopAppBar(
                        title = {
                            Text(
                                text = when (uiState.selectedTab) {
                                    GalleryTab.PHOTOS -> "PixelUp IA"
                                    GalleryTab.ALBUMS -> "Albumes"
                                    GalleryTab.SMART_AI -> "SnapVault IA"
                                },
                                style = MaterialTheme.typography.titleLarge,
                                fontWeight = FontWeight.Bold
                            )
                        },
                        actions = {
                            if (uiState.selectedTab != GalleryTab.SMART_AI) {
                                IconButton(
                                    onClick = { showSortMenu = true },
                                    modifier = Modifier.minimumInteractiveComponentSize()
                                ) {
                                    Icon(
                                        imageVector = Icons.AutoMirrored.Filled.Sort,
                                        contentDescription = "Ordenar"
                                    )
                                }
                                SortMenu(
                                    expanded = showSortMenu,
                                    currentOrder = uiState.sortOrder,
                                    onDismiss = { showSortMenu = false },
                                    onSortChange = { viewModel.onEvent(GalleryEvent.ChangeSortOrder(it)) }
                                )
                            }
                        },
                        colors = TopAppBarDefaults.topAppBarColors(
                            containerColor = MaterialTheme.colorScheme.surfaceContainerLowest
                        )
                    )
                }
            }
        }
    ) { paddingValues ->
        Box(
            modifier = Modifier
                .fillMaxSize()
                .padding(paddingValues)
        ) {
            Column(modifier = Modifier.fillMaxSize()) {
                if (!hasPermission) {
                    Box(
                        modifier = Modifier.fillMaxSize(),
                        contentAlignment = Alignment.Center
                    ) {
                        Surface(
                            modifier = Modifier.padding(24.dp),
                            shape = MaterialTheme.shapes.extraLarge,
                            color = MaterialTheme.colorScheme.surfaceContainerHigh
                        ) {
                            Column(
                                modifier = Modifier.padding(24.dp),
                                horizontalAlignment = Alignment.CenterHorizontally
                            ) {
                                Icon(
                                    imageVector = Icons.Default.Image,
                                    contentDescription = null,
                                    modifier = Modifier.size(64.dp),
                                    tint = MaterialTheme.colorScheme.primary
                                )
                                Spacer(modifier = Modifier.height(16.dp))
                                Text(
                                    text = "Permiso requerido",
                                    style = MaterialTheme.typography.titleLarge,
                                    fontWeight = FontWeight.Bold
                                )
                                Spacer(modifier = Modifier.height(8.dp))
                                Text(
                                    text = "PixelUp IA necesita acceso a tus fotos para organizarlas y visualizarlas.",
                                    style = MaterialTheme.typography.bodyMedium,
                                    color = MaterialTheme.colorScheme.onSurfaceVariant
                                )
                                Spacer(modifier = Modifier.height(20.dp))
                                Button(
                                    onClick = { permissionLauncher.launch(permission) },
                                    modifier = Modifier
                                        .fillMaxWidth()
                                        .height(56.dp),
                                    shape = MaterialTheme.shapes.medium
                                ) {
                                    Text("Conceder Permiso", style = MaterialTheme.typography.labelLarge)
                                }
                            }
                        }
                    }
                } else if (uiState.isLoading) {
                    Box(
                        modifier = Modifier.fillMaxSize(),
                        contentAlignment = Alignment.Center
                    ) {
                        CircularProgressIndicator(
                            color = MaterialTheme.colorScheme.primary,
                            modifier = Modifier.size(48.dp)
                        )
                    }
                } else if (uiState.errorMessage != null) {
                    Box(
                        modifier = Modifier.fillMaxSize(),
                        contentAlignment = Alignment.Center
                    ) {
                        Surface(
                            shape = MaterialTheme.shapes.large,
                            color = MaterialTheme.colorScheme.errorContainer,
                            modifier = Modifier.padding(24.dp)
                        ) {
                            Column(
                                modifier = Modifier.padding(20.dp),
                                horizontalAlignment = Alignment.CenterHorizontally
                            ) {
                                Icon(Icons.Default.ErrorOutline, contentDescription = null, tint = MaterialTheme.colorScheme.error)
                                Spacer(modifier = Modifier.height(8.dp))
                                Text(
                                    text = uiState.errorMessage ?: "Error desconocido",
                                    color = MaterialTheme.colorScheme.onErrorContainer,
                                    style = MaterialTheme.typography.bodyMedium
                                )
                                Spacer(modifier = Modifier.height(12.dp))
                                Button(onClick = { viewModel.onEvent(GalleryEvent.Refresh) }) {
                                    Text("Reintentar")
                                }
                            }
                        }
                    }
                } else {
                    // Contenido segun la pestana seleccionada
                    when (uiState.selectedTab) {
                        GalleryTab.PHOTOS -> {
                            PhotoGrid(
                                photos = uiState.photos,
                                selectedIds = uiState.selectedPhotoIds,
                                isSelectionMode = uiState.isSelectionMode,
                                onPhotoClick = { photo -> onPhotoClick(photo, false, null) },
                                onToggleSelection = { viewModel.onEvent(GalleryEvent.TogglePhotoSelection(it)) }
                            )
                        }
                        GalleryTab.ALBUMS -> {
                            AlbumGrid(
                                albums = uiState.albums,
                                onAlbumClick = onAlbumClick
                            )
                        }
                        GalleryTab.SMART_AI -> {
                            SmartGalleryView(
                                searchQuery = uiState.smartSearchQuery,
                                smartPhotos = uiState.smartPhotos,
                                allPhotos = uiState.photos,
                                indexedFolders = uiState.indexedFolders,
                                selectedIndexedFolder = uiState.selectedIndexedFolderName,
                                appCollections = uiState.appCollections,
                                visualCollections = uiState.visualCollections,
                                selectedSmartCollection = uiState.selectedSmartCollection,
                                hiddenCollections = uiState.hiddenCollections,
                                showHiddenCollectionsDialog = uiState.showHiddenCollectionsDialog,
                                showFolderManagerDialog = uiState.showFolderManagerDialog,
                                showIndexedCount = uiState.showIndexedCount,
                                allDeviceFolders = uiState.existingFolderNames,
                                chosenIndexFolders = uiState.chosenIndexFolders,
                                isBatchIndexing = uiState.isBatchIndexing,
                                batchIndexingProgress = uiState.batchIndexingProgress,
                                activeIndexingFolder = uiState.activeIndexingFolder,
                                isFolderEnriching = uiState.isFolderEnriching,
                                folderEnrichingProgress = uiState.folderEnrichingProgress,
                                activeEnrichingFolder = uiState.activeEnrichingFolder,
                                selectedIds = uiState.selectedPhotoIds,
                                isSelectionMode = uiState.isSelectionMode,
                                faceClusters = uiState.faceClusters,
                                memoryStories = uiState.memoryStories,
                                onStoryClick = { viewModel.onEvent(GalleryEvent.OpenStory(it)) },
                                onEditStoryName = { viewModel.onEvent(GalleryEvent.OpenEditStoryName(it)) },
                                onAddPhotosToStory = { viewModel.onEvent(GalleryEvent.OpenAddPhotosToStory(it)) },
                                onManageStoryPhotos = { viewModel.onEvent(GalleryEvent.OpenManageStoryPhotos(it)) },
                                onToggleStoryPin = { viewModel.onEvent(GalleryEvent.ToggleStoryPinned(it.storyId, !it.isPinned)) },
                                onDeleteStory = { viewModel.onEvent(GalleryEvent.DeleteStory(it.storyId)) },
                                onCreateManualStory = { viewModel.onEvent(GalleryEvent.ToggleCreateManualStoryDialog(true)) },
                                onOpenCollageView = { viewModel.onEvent(GalleryEvent.ToggleMomentsCollageView(true)) },
                                showMomentsCollageView = uiState.showMomentsCollageView,
                                onCloseCollageView = { viewModel.onEvent(GalleryEvent.ToggleMomentsCollageView(false)) },
                                selectedFaceCluster = uiState.selectedFaceCluster,
                                selectedFaceClusterPhotos = uiState.selectedFaceClusterPhotos,
                                showAddPhotosToClusterDialog = uiState.showAddPhotosToClusterDialog,
                                showMergeClusterDialog = uiState.showMergeClusterDialog,
                                showChooseCoverDialog = uiState.showChooseCoverDialog,
                                onSelectFaceCluster = { viewModel.onEvent(GalleryEvent.SelectFaceCluster(it)) },
                                onRenameFaceCluster = { id, name -> viewModel.onEvent(GalleryEvent.RenameFaceCluster(id, name)) },
                                onToggleAddPhotosToClusterDialog = { viewModel.onEvent(GalleryEvent.ToggleAddPhotosToClusterDialog(it)) },
                                onToggleMergeClusterDialog = { viewModel.onEvent(GalleryEvent.ToggleMergeClusterDialog(it)) },
                                onToggleChooseCoverDialog = { viewModel.onEvent(GalleryEvent.ToggleChooseCoverDialog(it)) },
                                onSetClusterCover = { clusterId, photo -> viewModel.onEvent(GalleryEvent.SetClusterCover(clusterId, photo)) },
                                onMergeFaceClusters = { targetId, sourceId -> viewModel.onEvent(GalleryEvent.MergeFaceClusters(targetId, sourceId)) },
                                onHideFaceCluster = { viewModel.onEvent(GalleryEvent.HideFaceCluster(it)) },
                                onAddPhotoToFaceCluster = { clusterId, photo -> viewModel.onEvent(GalleryEvent.AddPhotoToFaceCluster(clusterId, photo)) },
                                onRemovePhotoFromFaceCluster = { clusterId, photoId -> viewModel.onEvent(GalleryEvent.RemovePhotoFromFaceCluster(clusterId, photoId)) },
                                smartCollages = uiState.smartCollages,
                                selectedFilterType = uiState.selectedFilterType,
                                activeFilterChips = uiState.activeFilterChips,
                                onSelectFilterType = { viewModel.onEvent(GalleryEvent.SelectFilterType(it)) },
                                onToggleCustomizeFilterChips = { viewModel.onEvent(GalleryEvent.ToggleCustomizeFilterChipsDialog(it)) },
                                onRemoveCollagePhoto = { collage, photo -> viewModel.onEvent(GalleryEvent.RemoveCollagePhoto(collage, photo)) },
                                onAddCollagePhoto = { viewModel.onEvent(GalleryEvent.AddCollagePhoto(it)) },
                                onQueryChange = { viewModel.onEvent(GalleryEvent.UpdateSmartSearchQuery(it)) },
                                onSelectFolder = { viewModel.onEvent(GalleryEvent.SelectIndexedFolder(it)) },
                                onSelectSmartCollection = { viewModel.onEvent(GalleryEvent.SelectSmartCollection(it)) },
                                onHideCollection = { viewModel.onEvent(GalleryEvent.HideCollection(it)) },
                                onUnhideCollection = { viewModel.onEvent(GalleryEvent.UnhideCollection(it)) },
                                onToggleHiddenCollectionsDialog = { viewModel.onEvent(GalleryEvent.ToggleHiddenCollectionsDialog(it)) },
                                onToggleFolderManagerDialog = { viewModel.onEvent(GalleryEvent.ToggleFolderManagerDialog(it)) },
                                onToggleFolderIndexing = { viewModel.onEvent(GalleryEvent.ToggleFolderIndexing(it)) },
                                onToggleShowIndexedCount = { viewModel.onEvent(GalleryEvent.ToggleShowIndexedCount) },
                                onTriggerBatchIndex = { viewModel.onEvent(GalleryEvent.TriggerBatchIndexFolder(it)) },
                                onTriggerFolderEnrichment = { viewModel.onEvent(GalleryEvent.TriggerFolderMultimodalEnrichment(it)) },
                                onPhotoClick = { photo, collectionId -> onPhotoClick(photo, true, collectionId) },
                                onToggleSelection = { viewModel.onEvent(GalleryEvent.TogglePhotoSelection(it)) },
                                onToggleSemanticPhotosDialog = { viewModel.onEvent(GalleryEvent.ToggleSemanticPhotosDialog(it)) },
                                showAddPhotosToCollectionDialog = uiState.showAddPhotosToCollectionDialog,
                                onToggleAddPhotosToCollectionDialog = { viewModel.onEvent(GalleryEvent.ToggleAddPhotosToCollectionDialog(it)) },
                                onAddPhotoToSmartCollection = { col, photo -> viewModel.onEvent(GalleryEvent.AddPhotoToSmartCollection(col, photo)) }
                            )
                        }
                    }
                }
            }

            // BARRA FLOTANTE INFERIOR: NAVEGACION O ACCIONES POR LOTE (MATERIAL 3 EXPRESSIVE)
            AnimatedContent(
                targetState = uiState.isSelectionMode,
                transitionSpec = {
                    (slideInVertically(animationSpec = PixelUpIAMotion.spatialIntOffsetSpring) { it } +
                            fadeIn(animationSpec = PixelUpIAMotion.effectsFloatSpring))
                        .togetherWith(
                            slideOutVertically(animationSpec = PixelUpIAMotion.spatialIntOffsetSpring) { it } +
                                    fadeOut(animationSpec = PixelUpIAMotion.effectsFloatSpring)
                        )
                },
                modifier = Modifier
                    .align(Alignment.BottomCenter)
                    .padding(bottom = 24.dp)
                    .navigationBarsPadding(),
                label = "FloatingBottomBarTransition"
            ) { isSelection ->
                if (isSelection) {
                    // Barra de Acciones por Lote
                    Surface(
                        shape = CircleShape,
                        color = MaterialTheme.colorScheme.surfaceContainerHighest,
                        tonalElevation = 6.dp,
                        shadowElevation = 8.dp,
                        modifier = Modifier.padding(horizontal = 16.dp)
                    ) {
                        Row(
                            modifier = Modifier.padding(horizontal = 16.dp, vertical = 6.dp),
                            horizontalArrangement = Arrangement.spacedBy(12.dp),
                            verticalAlignment = Alignment.CenterVertically
                        ) {
                            if (uiState.selectedTab == GalleryTab.SMART_AI && uiState.selectedFaceCluster != null) {
                                val currentCluster = uiState.selectedFaceCluster
